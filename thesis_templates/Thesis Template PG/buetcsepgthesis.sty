% Thesis certification page
\newcounter{ex@minercount}
\def\sign@tureline{\stepcounter{ex@minercount}
  \\[1.250\bigskipamount]
  \arabic{ex@minercount}.&\rule{0.4\textwidth}{0.50pt}}

% This macro adjusts (reduces) font size depending on contents in this
% page.
\RequirePackage{relsize}
\long\def\fittop@ge#1{%
  \sbox0{\begin{minipage}[b]{\textwidth}#1\end{minipage}}%
  \ifdim\ht0>\textheight
  \smaller%
  \typeout{Trying \f@size pt size for certification page}%
  \fittop@ge{#1}%
  \else
  % New page and phantom section must be invokved when the actual
  % contents are being shipped out.
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{Board of Examiners}  
  \noindent\usebox0
  \fi}

\def\thesisacceptancepage{%
  % We need to preload the databases, otherwise multiloading error may
  % occur during font size trial.
  \ifbool{mscengg}{%
    \DTLloaddb[noheader]{Head}{parameters/headofcse.txt}}{\relax}
  \DTLloaddb[noheader]{Internal}{parameters/internalexaminers.txt}
  \ifbool{mscengg}{%
    \DTLloaddb[noheader]{External}{parameters/externalexaminer.txt}}{\relax}
  {\fittop@ge{\thesis@ccept@ncep@ge}}}


\def\thesis@ccept@ncep@ge{%
  The thesis titled ``\textbf{\thesistitle}'', submitted by
  \CandidateName, Student ID~\CandidateID, Session~\CandidateSession,
  to the \cse, \buet, has been accepted as satisfactory in partial
  fulfilment of the requirements for the degree of \degreefullname and
  approved as to its style and contents on~\thesislongdate.
  \nobreak
  \vspace{\stretch{2}}
  \nobreak
  \subsection*{\centering Board of Examiners}
  \nobreak
  \begingroup
  \renewcommand{\arraystretch}{1.0}
  \setcounter{ex@minercount}{0}
  \begin{tabular*}{\textwidth}{rl@{\extracolsep{\fill}}r}
    \sign@tureline\\
    &\SupervisorName&Chairman\\
    &\SupervisorDesignation&(Supervisor)\\
    &Department of CSE, BUET, Dhaka
    % Head is needed for M.Sc Engg
      \ifbool{mscengg}{%
      \DTLforeach*{Head}{\HeadName=Column1,\HeadDesignation=Column2}
      {\sign@tureline\\
    &\HeadName&Member\\
    &\HeadDesignation&(Ex-Officio)\\
    &Department of CSE, BUET, Dhaka}}{\relax}
      \DTLforeach*{Internal}{\InternalName=Column1,\InternalDesignation=Column2}
      {\sign@tureline\\
    &\InternalName&Member\\
    &\InternalDesignation\\
    &Department of CSE, BUET, Dhaka}
    % External examiner is needed for M.Sc Engg
      \ifbool{mscengg}{%
      \DTLforeach*{External}{\ExternalName=Column1,\ExternalDesignation=Column2,\ExternalAffiliationA=Column3,\ExternalAffiliationB=Column4,\ExternalAffiliationC=Column5}
      {\sign@tureline\\
    &\ExternalName&Member\\
    &\ExternalDesignation&(External)\\
    &\ifdefempty{\ExternalAffiliationA}{\relax}{\ExternalAffiliationA\\}
    &\ifdefempty{\ExternalAffiliationB}{\relax}{\ExternalAffiliationB\\}
    &\ifdefempty{\ExternalAffiliationC}{\relax}{\ExternalAffiliationC\\}}}{\relax}
  \end{tabular*}
  \endgroup
  \vspace{\stretch{1}}}

