\def\thesiscandidatesdeclaration{
  \section*{\centering Candidate's Declaration}
  \phantomsection\addcontentsline{toc}{chapter}{Candidate's Declaration}
    
  I, do, hereby, certify that the work presented in this thesis,
  titled, ``\thesistitle'', is the outcome of the investigation and
  research carried out by me under the supervision of \SupervisorName,
  \SupervisorDesignation, Department of CSE, BUET.

  \bigskip

  I also declare that neither this thesis nor any part thereof has
  been submitted anywhere else for the award of any degree, diploma or
  other qualifications.

  \vspace*{25.0mm}
  \rule{0.4\textwidth}{0.4pt}
  \vspace*{-\medskipamount}
  
  \CandidateName

  \CandidateID}

