# Copy this file to .env in the repository root and fill in the values.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env is gitignored. All four variables are required: agr/env.py raises at
# import time if any is missing, so even the tests that need neither Neo4j nor
# the API will fail to collect without them.

# Bolt endpoint of the Neo4j instance holding the knowledge environment.
# The default below matches a local Neo4j started on its standard port.
NEO4J_URI=bolt://localhost:7687

# Credentials set when the Neo4j database was initialised.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# https://platform.openai.com/api-keys
# Every model call is cached under cache/, so a repeated run costs nothing.
OPENAI_API_KEY=
