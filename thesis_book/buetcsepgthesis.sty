\RequirePackage[a4paper,left=25.0mm, right=25.0mm, top=20.0mm, bottom=10.0mm,includeheadfoot]{geometry}
\RequirePackage{times}
% times sets the sans face to Helvetica at full size, but Helvetica's x-height
% is far larger than Times's, so sans text set at the same nominal size looks
% bigger and heavier than the prose around it. The thesis marks identifiers in
% sans, and in a paragraph carrying several of them the page reads speckled.
% Scaling Helvetica to 92% matches the two faces optically. This is the
% conventional pairing correction, not a size change: the nominal size is
% unchanged, so nothing about the layout or the marking is affected.
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage{microtype}
% hyperref (loaded below) redefines \@footnotetext to wrap footnotes in a
% PDF link anchor once hyperfootnotes are active; microtype's `footnote'
% interface patch does a literal-text match against the kernel's original
% \@footnotetext and no longer finds it, so it always warns "Unable to
% apply patch `footnote'" even though no footnote has been typeset yet.
% Skip just that one interface -- all other microtype patches (item, toc,
% eqnum, protrusion/expansion in general) are unaffected.
\microtypesetup{nopatch=footnote}
\RequirePackage{cite}
\RequirePackage{url}
\RequirePackage{listings}
% Verbatim style for the prompt templates and Cypher of Appendices A and B.
% Prompts are reproduced exactly as the code sends them, so the listing must not
% reflow or reinterpret anything: no line numbers, no keyword styling, and
% columns=fullflexible so that spacing inside a template is preserved.
\lstdefinestyle{verbatimblock}{
  basicstyle=\footnotesize\ttfamily,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  breakindent=0pt,
  breakautoindent=false,
  postbreak={\mbox{$\hookrightarrow$\space}},
  numbers=none,
  frame=leftline,
  framesep=3mm,
  xleftmargin=4mm,
  aboveskip=2mm,
  belowskip=2mm}
% Multi-column lists for the question-identifier manifests of Appendix C.
\RequirePackage{multicol}

% Diagrams and plots. The state machine of Chapter 5 is drawn by hand; the three
% data figures are generated from results/phase4/thesis_numbers.json by
% scripts/build_figures.py, so that no plotted value is transcribed.
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,calc,fit,backgrounds,
  patterns}
% Figure palette. Okabe-Ito, which is colour-blind safe and whose members also
% differ in luminance, so a greyscale print keeps the series apart before the
% mark shapes do. The generated figures repeat these definitions at their own
% head so they stay self-contained and can be \input by the slide deck, which
% does not load this file; the hand-drawn diagrams read them from here.
\definecolor{agrNode}{HTML}{0072B2}   % a step that does work
\definecolor{agrSup}{HTML}{009E73}    % supported / the verification layer
\definecolor{agrUns}{HTML}{D55E00}    % unsupported
% One plot style for all data figures, so they read as one set. Greyscale-safe:
% every series is separated by mark shape as well as by colour, because the
% thesis is likely to be examined on paper.
\pgfplotsset{
  agrplot/.style={
    width=0.46\textwidth,
    height=52mm,
    tick label style={font=\scriptsize},
    label style={font=\small},
    title style={font=\small\bfseries},
    legend style={font=\scriptsize, draw=none, fill=none},
    grid=major,
    grid style={gray!25, very thin},
    axis line style={gray!60},
    tick align=outside,
    tick style={gray!60},
  }}
% setspace must load BEFORE hyperref. Both redefine \@footnotetext, and the
% loser silently discards the other's version: with setspace second, hyperref's
% footnote anchor is dropped, every \footnotemark points at a destination that
% was never written, and pdfTeX substitutes page 1. The reader clicking a
% footnote lands on the Candidate's Declaration. The template ships this order
% and therefore ships the defect; \onehalfspacing still fires at its original
% position below, so only the load order moves and the spacing is unchanged.
\RequirePackage{setspace}
\RequirePackage[final, colorlinks, linkcolor=blue, citecolor=blue, urlcolor=blue]{hyperref}

% Prevent math from being upcased
% http://tex.stackexchange.com/questions/46525/preventing-makeuppercase-from-affecting-mathematics
\RequirePackage{textcase}

