% sets spacing between paragraphs
\parskip \smallskipamount

% Clever referencing
\RequirePackage{cleveref}

% Caption setup
\RequirePackage{caption} 
\captionsetup[table]{skip=2.50mm}

% Fixed-width table columns, set ragged right rather than justified. A narrow
% p-column holds only two or three words per line, so justifying it opens large
% interword gaps and TeX reports an underfull \hbox for every such line. Use
% L{width} in place of p{width} for any column narrow enough for that to
% happen; \arraybackslash restores \\ as the row separator, which \raggedright
% would otherwise redefine.
\RequirePackage{array}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

% Section headings. The standard classes typeset headings justified, so a title
% long enough to wrap stretches its first line; see the deviation note at the
% top of this file for what removing these was measured to cost. These
% definitions are report.cls's own with \raggedright appended to the style
% argument; the spacing above and below each heading is unchanged, and no
% heading text differs. \paragraph and \subparagraph are deliberately left
% alone: they run in with the text that follows, and \raggedright there would
% unjustify that whole paragraph.
\renewcommand\section{\@startsection {section}{1}{\z@}%
                                     {-3.5ex \@plus -1ex \@minus -.2ex}%
                                     {2.3ex \@plus.2ex}%
                                     {\normalfont\Large\bfseries\raggedright}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
                                       {-3.25ex\@plus -1ex \@minus -.2ex}%
                                       {1.5ex \@plus .2ex}%
                                       {\normalfont\large\bfseries\raggedright}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
                                       {-3.25ex\@plus -1ex \@minus -.2ex}%
                                       {1.5ex \@plus .2ex}%
                                       {\normalfont\normalsize\bfseries\raggedright}}

% 1.5 spacing (setspace itself is loaded before hyperref, above)
