# ==========================================
# Environments & Secrets
# ==========================================
.env
.venv
env/
venv/
conda-env/
.Python

# ==========================================
# Python & Compilation Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# ==========================================
# Jupyter & IDEs
# ==========================================
.ipynb_checkpoints/
.vscode/
.idea/

# ==========================================
# Data & Datasets
# ==========================================
# The knowledge environment is rebuilt from the source datasets rather than
# committed: see scripts/union_graph_construction.py and the Phase 1 scripts.
cache/
datasets/
data/triple_index/
*.csv.gz
*.tsv
*.parquet
*.h5

# ==========================================
# Model Checkpoints & Weights
# ==========================================
models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ==========================================
# Logs, Profiling & Experiment Tracking
# ==========================================
# Experiment artifacts are committed under results/phase{1..4}/. scratch/ holds
# the incidental output of the probes run_one.py, verify_planner_noop.py and
# check_tools.py, which is not part of the experimental record.
scratch/
temp/
*.log
wandb/
mlruns/
tensorboard/
profile_results/

# ==========================================
# LaTeX build artifacts (thesis_book)
# ==========================================
thesis_book/*.aux
thesis_book/*.bbl
thesis_book/*.bcf
thesis_book/*.blg
thesis_book/*.fdb_latexmk
thesis_book/*.fls
thesis_book/*.idx
thesis_book/*.ilg
thesis_book/*.ind
thesis_book/*.loa
thesis_book/*.lof
thesis_book/*.lot
thesis_book/*.out
thesis_book/*.run.xml
thesis_book/*.synctex.gz
thesis_book/*.toc
thesis_book/*~

# LaTeX build artifacts (thesis_presentation). Same rule as thesis_book: the
# built PDFs are tracked, everything latexmk regenerates is not. .nav/.snm/.toc
# are beamer's navigation files. figures/ IS tracked -- it is generated, but by
# scripts/build_figures.py rather than by latexmk, exactly as thesis_book's is.
thesis_presentation/*.aux
thesis_presentation/*.fdb_latexmk
thesis_presentation/*.fls
thesis_presentation/*.log
thesis_presentation/*.nav
thesis_presentation/*.out
thesis_presentation/*.snm
thesis_presentation/*.toc
thesis_presentation/*.synctex.gz
thesis_presentation/*.png
thesis_presentation/*~

thesis_templates/brainstorming/

# ==========================================
# OS / System Artifacts
# ==========================================
.DS_Store
Thumbs.db
