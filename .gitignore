# ==========================================
# Environments & Secrets (CRITICAL)
# ==========================================
.env
.venv
env/
venv/
conda-env/
.Python

# ==========================================
# Python & Compilation Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# ==========================================
# Jupyter & IDEs
# ==========================================
.ipynb_checkpoints/
.vscode/
.idea/

# ==========================================
# Data & Datasets (Prevent Repo Bloat)
# ==========================================
# It is usually best to ignore the entire data folder, 
# or specific large file formats common in training/graphs
cache/
datasets/
data/triple_index/
*.csv.gz
*.tsv
*.parquet
*.h5

# ==========================================
# Model Checkpoints & Weights
# ==========================================
models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ==========================================
# Logs, Profiling & Experiment Tracking
# ==========================================
temp/
*.log
wandb/
mlruns/
tensorboard/
profile_results/

# ==========================================
# LaTeX build artifacts (thesis_book)
# ==========================================
thesis_book/*.aux
thesis_book/*.bbl
thesis_book/*.bcf
thesis_book/*.blg
thesis_book/*.fdb_latexmk
thesis_book/*.fls
thesis_book/*.idx
thesis_book/*.ilg
thesis_book/*.ind
thesis_book/*.loa
thesis_book/*.lof
thesis_book/*.lot
thesis_book/*.out
thesis_book/*.pdf
thesis_book/*.run.xml
thesis_book/*.synctex.gz
thesis_book/*.toc
thesis_book/*~

# ==========================================
# OS / System Artifacts
# ==========================================
.DS_Store
Thumbs.db
