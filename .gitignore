# ==========================================
# Environments & Secrets
# ==========================================
.env
.venv
env/
venv/
conda-env/
.Python

# ==========================================
# Python & Compilation Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# ==========================================
# Jupyter & IDEs
# ==========================================
.ipynb_checkpoints/
.vscode/
.idea/

# ==========================================
# Data & Datasets
# ==========================================
# The knowledge environment is rebuilt from the source datasets rather than
# committed: see scripts/union_graph_construction.py and the Phase 1 scripts.
cache/
datasets/
data/triple_index/
*.csv.gz
*.tsv
*.parquet
*.h5

# ==========================================
# Model Checkpoints & Weights
# ==========================================
models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# ==========================================
# Logs, Profiling & Experiment Tracking
# ==========================================
# Experiment artifacts are committed under results/phase{1..4}/. scratch/ holds
# the incidental output of the probes run_one.py, verify_planner_noop.py and
# check_tools.py, which is not part of the experimental record.
scratch/
temp/
*.log
wandb/
mlruns/
tensorboard/
profile_results/

# ==========================================
# LaTeX build artifacts (thesis_book)
# ==========================================
thesis_book/*.aux
thesis_book/*.bbl
thesis_book/*.bcf
thesis_book/*.blg
thesis_book/*.fdb_latexmk
thesis_book/*.fls
thesis_book/*.idx
thesis_book/*.ilg
thesis_book/*.ind
thesis_book/*.loa
thesis_book/*.lof
thesis_book/*.lot
thesis_book/*.out
thesis_book/*.run.xml
thesis_book/*.synctex.gz
# synctex writes .synctex(busy) while it compresses and removes it
# after. A probe sweep running beside a build catches it mid-flight and
# reports it as a file some probe failed to restore.
thesis_book/*.synctex(busy)
thesis_book/*.toc
thesis_book/*~

# LaTeX build artifacts (thesis_presentation). Same rule as thesis_book: the
# built PDFs are tracked, everything latexmk regenerates is not. .nav/.snm/.toc
# are beamer's navigation files. figures/ IS tracked -- it is generated, but by
# scripts/build_figures.py rather than by latexmk, exactly as thesis_book's is.
thesis_presentation/*.aux
thesis_presentation/*.fdb_latexmk
thesis_presentation/*.fls
thesis_presentation/*.log
thesis_presentation/*.nav
thesis_presentation/*.out
thesis_presentation/*.snm
thesis_presentation/*.toc
thesis_presentation/*.synctex.gz
# synctex writes .synctex(busy) while it compresses and removes it
# after. A probe sweep running beside a build catches it mid-flight and
# reports it as a file some probe failed to restore.
thesis_presentation/*.synctex(busy)
thesis_presentation/*.png
thesis_presentation/*~

# LaTeX build artifacts (thesis_paper). Same rule as the other two modules:
# agr-paper.pdf is tracked so the submitted manuscript is in the history,
# everything latexmk regenerates is not. figures/ IS tracked -- generated by
# scripts/build_figures.py --target paper, not by latexmk.
#
# .spl is elsarticle's, via the line numbering the `review' option turns on;
# .bbl is regenerated by latexmk, so it stays out even though Elsevier's
# editorial system asks you to upload one with the submission.
thesis_paper/*.aux
thesis_paper/*.bbl
thesis_paper/*.blg
thesis_paper/*.fdb_latexmk
thesis_paper/*.fls
thesis_paper/*.log
thesis_paper/*.out
thesis_paper/*.spl
thesis_paper/*.synctex.gz
# synctex writes .synctex(busy) while it compresses and removes it
# after. A probe sweep running beside a build catches it mid-flight and
# reports it as a file some probe failed to restore.
thesis_paper/*.synctex(busy)
thesis_paper/*~

# LaTeX build artifacts (thumbnail). thumbnail.tex is generated by
# build_thumbnail.py and IS tracked, on the same rule as the generated
# figures: what a script writes from committed data belongs in the
# history. The .pdf and .png are the deliverables and are tracked too, so
# the card that actually went on the event page is recoverable.
thumbnail/*.aux
thumbnail/*.fdb_latexmk
thumbnail/*.fls
thumbnail/*.log
thumbnail/*.synctex.gz
# synctex writes .synctex(busy) while it compresses and removes it
# after. A probe sweep running beside a build catches it mid-flight and
# reports it as a file some probe failed to restore.
thumbnail/*.synctex(busy)

thesis_templates/brainstorming/

# ==========================================
# OS / System Artifacts
# ==========================================
.DS_Store
Thumbs.db

# LaTeX build artifacts (poster). Same rule as the thesis modules:
# the built poster PDF is tracked, everything latexmk regenerates is not.
# The poster is a beamer document, so it drops .nav/.snm/.toc/.vrb even
# though it has exactly one frame and no navigation to speak of.
poster/*.aux
poster/*.fdb_latexmk
poster/*.fls
poster/*.log
poster/*.nav
poster/*.out
poster/*.snm
poster/*.toc
poster/*.vrb
poster/*.synctex.gz
poster/*.synctex(busy)
poster/*~
